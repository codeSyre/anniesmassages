{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "rootDir": "./resources/ts",
    "outDir": "./assets/js",
    "strict": true,
    "noEmitOnError": true,
    "sourceMap": true,
    "incremental": true,
    "tsBuildInfoFile": "./.tsbuildinfo",
    "skipLibCheck": true
  },
  "include": ["resources/ts/**/*.ts"]
}
